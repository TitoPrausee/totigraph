        +bool keyword_match
        +string[] zielgruppen
        +string sprache
        +datetime published_date
        +int popularity
        +string source_system
        +string source_url
        +string source_label
        +datetime last_synced
    }
    class EventDokument {
        +datetime beginn
        +datetime ende
        +string veranstalter
        +string ort
        +string format
        +string kategorie
        +string geo
    }
    class MediaDokument {
        +string opencast_id
        +string serientitel
        +int dauer_sekunden
        +datetime aufnahmedatum
        +string medientyp
        +string transkription
        +string[] kapitelmarken
        +string lizenz
        +string thumbnail_url
    }
    class Kursdokument {
        +string semester
        +string veranstaltungsart
        +string[] modulzuordnung
        +string studiengang
    }
    class Suggestdokument {
        +string suchbegriff
        +string quelle
        +int gewicht
    }
    class Vektoreintrag {
        +string doc_id
        +string modell
        +int dimension
        +number[] vektor
    }
    IndexDokument <|-- EventDokument : Index campus_events
    IndexDokument <|-- MediaDokument : Index campus_media
